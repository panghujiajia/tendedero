/* PeggedView */
"Copied" = "Copiado";
"Choose" = "Elegir";
"Choose an available folder you can read and write to, then try again." = "Elige una carpeta disponible con permisos de lectura y escritura e inténtalo de nuevo.";
"Choose screenshots folder" = "Elegir carpeta de capturas";
